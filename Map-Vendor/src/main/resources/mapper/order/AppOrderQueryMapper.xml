<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mapvendor.module.order.repository.AppOrderQueryMapper">
  <sql id="columns">id,order_no,openid,business_id,business_name_snapshot,business_type,service_type,
    contact_name,contact_phone,people_num,service_date,status,car_id,car_spec_snapshot,car_quantity,service_mode,
    room_id,room_spec_snapshot,room_quantity,meal_period,option_snapshot_json,confirmed_at,cancelled_at,
    cancel_source,cancel_reason,created_at,updated_at</sql>
  <select id="countByOpenid" resultType="long">
    SELECT COUNT(*) FROM reserve_order WHERE openid=#{openid}
  </select>
  <select id="selectPageByOpenid" resultType="com.mapvendor.module.order.repository.AdminOrderRow">
    SELECT <include refid="columns"/> FROM reserve_order WHERE openid=#{openid}
    ORDER BY created_at DESC,id DESC LIMIT #{pageSize} OFFSET #{offset}
  </select>
  <select id="selectByIdAndOpenid" resultType="com.mapvendor.module.order.repository.AdminOrderRow">
    SELECT <include refid="columns"/> FROM reserve_order WHERE id=#{id} AND openid=#{openid}
  </select>
  <select id="selectById" resultType="com.mapvendor.module.order.repository.AdminOrderRow">
    SELECT <include refid="columns"/> FROM reserve_order WHERE id=#{id}
  </select>
  <update id="cancelPendingByUser">
    UPDATE reserve_order
    SET status='CANCELLED',cancelled_at=CURRENT_TIMESTAMP(3),cancel_source='USER',cancel_reason=NULL,version=version+1
    WHERE id=#{id} AND openid=#{openid} AND status='PENDING'
  </update>
  <insert id="insertUserCancelLog">
    INSERT INTO order_status_log
      (order_id,from_status,to_status,operator_type,operator_id,reason,request_id,created_at)
    VALUES (#{orderId},'PENDING','CANCELLED','USER',NULL,NULL,#{requestId},CURRENT_TIMESTAMP(3))
  </insert>
</mapper>
